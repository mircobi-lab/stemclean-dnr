{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StemClean DNR",
  "version": "2.0.0",
  "identifier": "it.mbstudio91.stemclean",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StemClean DNR — MBStudio91",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#0f0d0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Toglie i rientri dagli stem separati",
    "copyright": "© 2026 Mirco Baiocco — MBStudio91",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
